{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MercySF Reborn",
  "version": "0.3.1",
  "identifier": "app.mercysf.reborn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MercySF Reborn",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
